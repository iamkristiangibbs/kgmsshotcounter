rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(code) {
      return request.auth != null
          && get(/databases/$(database)/documents/sessions/$(code)).data.owner == request.auth.uid;
    }

    match /sessions/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /members/{key} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.resource.data.keys().hasOnly(['name', 'nameKey', 'joined', 'lastSeen', 'uid'])
                              && request.resource.data.uid == request.auth.uid
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 24;
        allow delete: if isOwner(code);
      }

      match /comments/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['target', 'author', 'authorName', 'text', 'ts', 'replyTo'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280
                      && request.resource.data.author is string
                      && request.resource.data.author.size() <= 24;
        allow delete: if request.auth != null;
      }

      match /drinks/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['member', 'name', 'type', 'ts'])
                      && request.resource.data.type in ['shot', 'beer', 'water']
                      && request.resource.data.member is string
                      && request.resource.data.member.size() <= 24;
        allow delete: if request.auth != null;
      }
    }
  }
}
