rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;

      match /members/{key} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
                              && request.resource.data.keys().hasOnly(['name', 'joined', 'lastSeen'])
                              && request.resource.data.name is string
                              && request.resource.data.name.size() <= 24;
        allow delete: if false;
      }

      match /drinks/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['member', 'name', 'type', 'ts'])
                      && request.resource.data.type in ['shot', 'beer', 'water']
                      && request.resource.data.member is string
                      && request.resource.data.member.size() <= 24;
        allow delete: if request.auth != null;
      }
    }
  }
}
