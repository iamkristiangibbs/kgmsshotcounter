rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(code) {
      return signedIn()
          && get(/databases/$(database)/documents/sessions/$(code)).data.owner == request.auth.uid;
    }

    match /sessions/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner']);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{key} {
        allow read: if signedIn();

        function validMember() {
          return signedIn()
              && request.resource.data.keys().hasOnly(['name', 'nameKey', 'joined', 'lastSeen', 'uid', 'photo'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.name is string
              && request.resource.data.name.size() <= 24
              && (!('photo' in request.resource.data)
                  || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40000));
        }

        // New members need a username of at least 4 characters.
        allow create: if validMember() && request.resource.data.name.size() >= 4;

        // Only the phone a member belongs to can change it (or claim it if it was reset / never bound).
        allow update: if validMember()
                      && (request.resource.data.name == resource.data.name
                          || request.resource.data.name.size() >= 4)
                      && resource.data.get('uid', '') in [request.auth.uid, ''];

        // The session owner can unbind a member from a lost phone.
        allow update: if isOwner(code)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
                      && request.resource.data.uid == '';

        allow delete: if isOwner(code);
      }

      match /drinks/{id} {
        allow read: if signedIn();

        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['member', 'name', 'type', 'ts', 'uid'])
                      && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
                      && request.resource.data.type in ['shot', 'beer', 'water']
                      && request.resource.data.member is string
                      && request.resource.data.member.size() <= 24;

        // You can only remove drinks you logged from this phone (the session owner can remove any).
        allow delete: if signedIn()
                      && (resource.data.get('uid', '') == request.auth.uid || isOwner(code));
      }

      match /comments/{id} {
        allow read: if signedIn();

        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['target', 'author', 'authorName', 'text', 'ts', 'replyTo', 'uid'])
                      && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 280
                      && request.resource.data.author is string
                      && request.resource.data.author.size() <= 24;

        allow delete: if signedIn()
                      && (resource.data.get('uid', '') == request.auth.uid || isOwner(code));
      }
    }
  }
}
